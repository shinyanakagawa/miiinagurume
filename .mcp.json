{
  "mcpServers": {

    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--project-ref",
        "fgwoqrnjrsnnhogxvtof"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "YOUR_SUPABASE_PERSONAL_ACCESS_TOKEN"
      }
    },

    "notion": {
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": {
        "OPENAPI_MCP_HEADERS": "{\"Authorization\": \"Bearer YOUR_NOTION_INTEGRATION_TOKEN\", \"Notion-Version\": \"2022-06-28\"}"
      }
    },

    "github": {
      "command": "npx",
      "args": ["-y", "@github/mcp-server"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_PERSONAL_ACCESS_TOKEN"
      }
    },

    "canva": {
      "type": "http",
      "url": "https://mcp.canva.com/mcp"
    },

    "google-drive": {
      "type": "http",
      "url": "https://mcp.googleapis.com/drive/v1/mcp"
    },

    "gmail": {
      "type": "http",
      "url": "https://mcp.googleapis.com/gmail/v1/mcp"
    },

    "google-calendar": {
      "type": "http",
      "url": "https://mcp.googleapis.com/calendar/v3/mcp"
    }

  }
}
